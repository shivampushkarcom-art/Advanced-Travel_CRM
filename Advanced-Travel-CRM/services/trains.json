{
  "label": "Train Bookings",
  "icon": "train",
  "theme": {
    "package_details_style": "irctc",
    "color_scheme": {
      "primary": "#d32f2f",
      "secondary": "#f44336",
      "accent": "#ff9800"
    },
    "layout": "single-column"
  },
  "search_fields": [
    {
      "id": "from_station",
      "label": "From Station",
      "type": "text",
      "placeholder": "Departure station",
      "required": true
    },
    {
      "id": "to_station",
      "label": "To Station",
      "type": "text",
      "placeholder": "Arrival station",
      "required": true
    },
    {
      "id": "journey_date",
      "label": "Journey Date",
      "type": "date",
      "required": true
    },
    {
      "id": "passengers",
      "label": "Passengers",
      "type": "number",
      "min": 1,
      "default": 1
    },
    {
      "id": "class",
      "label": "Class",
      "type": "select",
      "options": ["Sleeper", "3AC", "2AC", "1AC", "Chair Car"],
      "default": "3AC"
    }
  ],
  "booking_fields": [
    {
      "id": "name",
      "label": "Full Name",
      "type": "text",
      "required": true
    },
    {
      "id": "email",
      "label": "Email",
      "type": "email",
      "required": true
    },
    {
      "id": "phone",
      "label": "Phone",
      "type": "tel",
      "required": true
    },
    {
      "id": "adults",
      "label": "Adults",
      "type": "number",
      "min": 1,
      "default": 1
    },
    {
      "id": "children",
      "label": "Children",
      "type": "number",
      "min": 0,
      "default": 0
    },
    {
      "id": "class",
      "label": "Class",
      "type": "select",
      "options": ["Sleeper", "3AC", "2AC", "1AC", "Chair Car"],
      "default": "3AC"
    },
    {
      "id": "berth_preference",
      "label": "Berth Preference",
      "type": "select",
      "options": ["Lower", "Middle", "Upper", "Side Lower", "Side Upper", "No Preference"],
      "default": "No Preference"
    },
    {
      "id": "meal_preference",
      "label": "Meal Preference",
      "type": "select",
      "options": ["Vegetarian", "Non-Vegetarian", "Jain", "No Meal"],
      "default": "No Meal"
    }
  ],
  "package_fields": [
    {
      "id": "train_number",
      "label": "Train Number",
      "type": "text",
      "required": true,
      "placeholder": "e.g., 12345"
    },
    {
      "id": "train_name",
      "label": "Train Name",
      "type": "text",
      "required": true,
      "placeholder": "e.g., Rajdhani Express"
    },
    {
      "id": "from_station",
      "label": "From Station",
      "type": "text",
      "required": true,
      "placeholder": "Station name and code"
    },
    {
      "id": "to_station",
      "label": "To Station",
      "type": "text",
      "required": true,
      "placeholder": "Station name and code"
    },
    {
      "id": "departure_time",
      "label": "Departure Time",
      "type": "text",
      "placeholder": "e.g., 10:30 AM"
    },
    {
      "id": "arrival_time",
      "label": "Arrival Time",
      "type": "text",
      "placeholder": "e.g., 2:45 PM (next day)"
    },
    {
      "id": "journey_duration",
      "label": "Journey Duration",
      "type": "text",
      "placeholder": "e.g., 16h 15m"
    },
    {
      "id": "available_classes",
      "label": "Available Classes",
      "type": "textarea",
      "placeholder": "Sleeper, 3AC, 2AC, 1AC (one per line)"
    },
    {
      "id": "cancellation_policy",
      "label": "Cancellation Policy",
      "type": "textarea",
      "placeholder": "Cancellation charges and terms"
    },
    {
      "id": "rescheduling_policy",
      "label": "Rescheduling Policy",
      "type": "textarea",
      "placeholder": "Rescheduling terms and charges"
    },
    {
      "id": "refund_policy",
      "label": "Refund Policy",
      "type": "textarea",
      "placeholder": "Refund terms and conditions"
    },
    {
      "id": "facilities",
      "label": "Train Facilities",
      "type": "textarea",
      "placeholder": "AC, Pantry, WiFi, etc."
    }
  ],
  "query_fields": [
    {
      "id": "from_station",
      "label": "From Station",
      "type": "text",
      "section": "service_specific",
      "required": true
    },
    {
      "id": "to_station",
      "label": "To Station",
      "type": "text",
      "section": "service_specific",
      "required": true
    },
    {
      "id": "journey_date",
      "label": "Journey Date",
      "type": "date",
      "section": "service_specific",
      "required": true
    },
    {
      "id": "return_date",
      "label": "Return Date (if round trip)",
      "type": "date",
      "section": "service_specific"
    },
    {
      "id": "adults",
      "label": "Number of Adults",
      "type": "number",
      "section": "service_specific",
      "min": 1,
      "default": 1,
      "required": true
    },
    {
      "id": "children",
      "label": "Number of Children",
      "type": "number",
      "section": "service_specific",
      "min": 0,
      "default": 0
    },
    {
      "id": "preferred_class",
      "label": "Preferred Class",
      "type": "select",
      "section": "service_specific",
      "options": ["Sleeper", "3AC", "2AC", "1AC", "Chair Car"],
      "default": "3AC"
    },
    {
      "id": "berth_preference",
      "label": "Berth Preference",
      "type": "select",
      "section": "service_specific",
      "options": ["Lower", "Middle", "Upper", "Side Lower", "Side Upper", "No Preference"],
      "default": "No Preference"
    },
    {
      "id": "flexible_dates",
      "label": "Flexible with Dates",
      "type": "select",
      "section": "service_specific",
      "options": ["Yes", "No"],
      "default": "No"
    },
    {
      "id": "special_requirements",
      "label": "Special Requirements",
      "type": "textarea",
      "section": "additional",
      "placeholder": "Wheelchair assistance, special meals, etc."
    }
  ],
  "pricing": {
    "adult_rate": 1200,
    "child_discount": 0.5,
    "currency": "INR"
  }
}
